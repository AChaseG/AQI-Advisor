{
  "$schema": "https://raw.githubusercontent.com/slackapi/manifest-schema/main/schemas/manifest.schema.2.0.0.json",
  "display_information": {
    "name": "AQI Advisor",
    "description": "Watch air quality for any US address and post AQI updates to the channel every 45 minutes.",
    "background_color": "#1b7f5a"
  },
  "features": {
    "bot_user": {
      "display_name": "AQI Advisor",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/aqi",
        "description": "Watch a US address and report its air quality in this channel",
        "usage_hint": "add 400 Broad St, Seattle, WA 98109",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "chat:write.public",
        "app_mentions:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_mention"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
